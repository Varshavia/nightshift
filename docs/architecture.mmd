---
config:
  theme: base
  themeVariables:
    primaryColor: "#eef2ff"
    primaryTextColor: "#0f172a"
    primaryBorderColor: "#6366f1"
    lineColor: "#475569"
    fontSize: "15px"
---
flowchart TB
    subgraph nightly["① NIGHTLY SCAN — one process, whole fleet, then exits"]
        direction LR
        SCH["Cloud Scheduler<br/>02:00 daily"] --> SCAN["Scanner<br/>Cloud Run Job"]
        POOL[("Fork pool<br/>reviewed list")] --> SCAN
        SCAN --> OSV["OSV.dev<br/><b>one</b> batched query"]
        OSV --> TRIAGE["<b>Triage agent</b><br/>Gemma 3<br/>drop the noise"]
        TRIAGE --> PS(["Pub/Sub<br/>1 message per affected repo"])
    end

    PS --> W1["Worker 1"]
    PS --> W2["Worker 2"]
    PS --> WN["Worker N"]

    subgraph worker["② INSIDE ONE WORKER — Cloud Run Job, isolated sandbox"]
        direction TB
        CLONE["clone fork"] --> BASE["<b>BASELINE</b><br/>run the suite untouched"]
        BASE -->|"already red"| RED(["BASELINE_RED"])
        BASE -->|"won't build"| UNB(["UNBUILDABLE"])
        BASE -->|"green"| UPG["<b>UPGRADE</b><br/>rewrite the manifest"]
        UPG --> VER["<b>VERIFY</b><br/>run the suite again"]
        VER -->|"still green"| CLEAN(["PATCHED_CLEAN<br/><i>no model called</i>"])

        subgraph repair["③ REPAIR LOOP — this is the product"]
            direction TB
            LOOK{{"LEDGER LOOKUP<br/>exact · near · miss"}}
            ARMOR{{"MODEL ARMOR<br/>screen untrusted repo text"}}
            AGENT["<b>Repair agent</b><br/>Gemini 3.5 Flash → Pro<br/>read the traceback,<br/>read the library's own source,<br/>make one conceptual fix"]
            POL{{"POLICY ENGINE<br/>every tool call"}}
            RUN["re-run the suite"]
            LOOK -->|"prior art"| ARMOR
            ARMOR --> AGENT
            AGENT --> POL
            POL -->|"deny: tests, CI, escape,<br/>merge, force-push"| AGENT
            POL -->|"allow"| RUN
            RUN -->|"still red,<br/>budget remaining"| AGENT
        end

        VER -->|"red"| LOOK
        AGENT -->|"ceiling hit"| EXH(["REPAIR_EXHAUSTED"])
        RUN -->|"green"| REV["<b>Reviewer agent</b><br/>Gemini 3.5 Flash<br/>no test edits · no secrets<br/>no PII · scoped to the failure"]
        REV -->|"blocked"| BLOCKED(["POLICY_BLOCKED"])
        REV -->|"approved"| PR["open the PR<br/>AI authorship disclosed"]
        PR --> DONE(["PATCHED_REPAIRED"])
    end

    subgraph ledger["④ THE MIGRATION LEDGER — the fleet gets cheaper as it works"]
        direction LR
        LIB["<b>Librarian agent</b><br/>Gemini 3.5 Pro<br/>generalise the fix<br/>into a recipe"]
        MEM[("Memory Bank<br/>scope: library + from→to<br/>provisional → verified")]
        LIB -->|"CreateMemory"| MEM
    end

    W1 --> CLONE
    REV -.->|"what worked"| LIB
    MEM -.->|"RetrieveMemories"| LOOK

    FS[("Firestore<br/>checkpoint per phase<br/>+ ledger of record")]
    TRACE[("Cloud Trace · OpenTelemetry<br/>ledger.hit · agent.version · policy.rule")]
    BASE -.-> FS
    UPG -.-> FS
    RUN -.-> FS
    DONE -.-> FS
    MEM -.-> FS
    RUN -.-> TRACE
    FS --> API["Read API<br/>Cloud Run"]
    TRACE --> API
    API --> DASH["Control tower<br/>Next.js"]

    classDef outcome fill:#0f172a,stroke:#0f172a,color:#f8fafc,font-weight:bold
    classDef star fill:#fff7ed,stroke:#f59e0b,stroke-width:3px,color:#7c2d12
    classDef policy fill:#fef2f2,stroke:#b91c1c,stroke-width:2px,color:#7f1d1d
    classDef gate fill:#f1f5f9,stroke:#475569,color:#0f172a

    class RED,UNB,CLEAN,EXH,DONE,BLOCKED outcome
    class AGENT,LIB star
    class POL,ARMOR policy
    class BASE,UPG,VER,LOOK,REV,TRIAGE gate

    style nightly fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:4 3
    style worker fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:4 3
    style repair fill:#fffbeb,stroke:#f59e0b,stroke-width:3px
    style ledger fill:#f0fdf4,stroke:#16a34a,stroke-width:3px
