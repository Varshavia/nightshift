# Nightshift configuration.
#
# Copy to .env and fill in. Never commit .env — every value below is read from
# the environment at runtime and nothing credential-shaped belongs in git.
# New variables go here with a comment and no value.

# --- Google Cloud ----------------------------------------------------------
# GCP project that owns Cloud Run, Pub/Sub, Firestore and Scheduler.
NIGHTSHIFT_GCP_PROJECT=
# Region for Cloud Run services and jobs.
NIGHTSHIFT_GCP_REGION=us-central1
# Pub/Sub topic the scanner publishes one message per affected repository to.
NIGHTSHIFT_JOBS_TOPIC=nightshift-jobs
# Firestore database id. "(default)" unless a named database was created.
NIGHTSHIFT_FIRESTORE_DATABASE=(default)
# Where the worker builds clones. Leave as /workspace in the container; set to a
# writable path (e.g. /tmp/nightshift) when running locally.
NIGHTSHIFT_WORKSPACE_ROOT=/workspace

# --- Models ----------------------------------------------------------------
# Repair agent. Hackathon rules require Gemini 3.5 or newer.
NIGHTSHIFT_REPAIR_MODEL=gemini-3.5-flash
# Reached for after Flash has had its attempts — a harder model for a harder break.
NIGHTSHIFT_ESCALATION_MODEL=gemini-3.5-pro

# Where the models are served, which is not where the fleet runs. Vertex
# publishes new Gemini versions on "global" first and to named regions later;
# asking us-central1 for Gemini 3.5 Flash returns a 404 that reads like a
# permissions problem and is a geography one.
NIGHTSHIFT_MODEL_LOCATION=global
# Cheap triage pass over raw OSV advisories before any job is published.
NIGHTSHIFT_TRIAGE_MODEL=gemma-3-27b-it
# Set to "vertex" to route through Vertex AI, "api" for the Gemini API.
NIGHTSHIFT_MODEL_BACKEND=vertex
# Only needed when NIGHTSHIFT_MODEL_BACKEND=api.
GOOGLE_API_KEY=

# --- GitHub ----------------------------------------------------------------
# Token for the org that owns the fork pool. Needs repo scope on that org only.
GITHUB_TOKEN=
# Org the forks live in. The fleet never operates outside it.
NIGHTSHIFT_FORK_ORG=
# The reviewed list of repositories the fleet may touch, built by
# scripts/build_fork_pool.py. A path, not a query: the fleet never discovers its
# own targets. A missing file is an error, never an empty fleet. See ADR 0002.
NIGHTSHIFT_FLEET_POOL=fleet/pool.json

# --- Safety ceilings -------------------------------------------------------
# Hard stops for the repair loop. Every loop has a ceiling. See CLAUDE.md §3.
NIGHTSHIFT_MAX_REPAIR_ATTEMPTS=4
NIGHTSHIFT_MAX_JOB_SECONDS=1800
NIGHTSHIFT_MAX_JOB_TOKENS=400000
NIGHTSHIFT_MAX_CONCURRENT_WORKERS=25

# --- Policy ----------------------------------------------------------------
# Opening a PR against a repository we do not own is opt-in and off by default.
# Flipping this to true is a human decision, per repository. See RESPONSIBLE_USE.md.
ALLOW_UPSTREAM_PRS=false
# There is no auto-merge flag and there will not be one. Nothing merges itself.

# Guards the one write the control tower exposes: approving a repository's
# pull request to go upstream. Reads are public so a reviewer needs no
# credentials; this is not. Generated by infra/deploy.sh and stored in
# Secret Manager — set it here only for a local run.
NIGHTSHIFT_APPROVAL_KEY=

# A second GitHub token, with NO scopes ticked. The scanner reads manifests
# through the contents API and cannot do it anonymously — that quota is sixty
# requests an hour, and a refused request comes back looking like a repository
# with no tests rather than like an error. A scopeless classic token reads
# public data and writes nothing, which is exactly the scanner's job.
# Only infra/deploy.sh reads this; the services see it as GITHUB_TOKEN.
GITHUB_READ_TOKEN=
