From 4cfe5e3327a1a5d7fae26ca9e47b3bab33476241 Mon Sep 17 00:00:00 2001
From: Nightshift <noreply@example.com>
Date: Wed, 19 Aug 2026 08:28:30 +0000
Subject: [PATCH 1/2] fix(ci): type-check google.genai like the rest of the
 Google stack

google-adk declares google-genai as an unconditional dependency, so CI installs
it and mypy resolves the import in agent.py. The override list covered
google.cloud, google.adk and github but not google.genai, so `make check` passed
locally on a machine without the package and failed in CI on one with it.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 3771d0d..6048878 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -73,5 +73,5 @@ strict = true
 warn_unreachable = true
 # Third-party packages without stubs. Keep this list short and justified.
 [[tool.mypy.overrides]]
-module = ["google.cloud.*", "google.adk.*", "github.*"]
+module = ["google.cloud.*", "google.adk.*", "google.genai.*", "github.*"]
 ignore_missing_imports = true
